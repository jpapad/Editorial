# Supabase project credentials — Project Settings > API in the Supabase dashboard.
# Copy this file to .env.local and fill in your values (.env.local is gitignored).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# services/aiGenerator.ts — Sprint 5 AI Line-Art Assistant. Server-only,
# never exposed to the client. Only the provider(s) you actually call need
# a real value.
FAL_KEY=your-fal-ai-key
OPENAI_API_KEY=your-openai-key
